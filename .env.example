# Watcher Mode: "cookie" or "api"
X_WATCHER_MODE=cookie
X_USERNAME=target_username
POLL_INTERVAL_MS=2000

# Mode A: Official API credentials
X_BEARER_TOKEN=

# Mode B: Cookie credentials
X_AUTH_TOKEN=
X_CT0=

# Base read-only RPC
RPC_URL=https://mainnet.base.org

# Target verification criteria
TARGET_TICKER=DEGEN
TARGET_NAME=Degen

# Demo simulation settings
BUY_AMOUNT_ETH=0.01
MAX_SLIPPAGE_BPS=2000
DRY_RUN=true
DEMO_AUTO_BUY=true

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
