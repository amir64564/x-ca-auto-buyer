# X API
X_BEARER_TOKEN=
X_USERNAME=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Base / 0x
ZEROX_API_KEY=
RPC_URL=https://mainnet.base.org
PRIVATE_KEY=

# Strategy: BOTH the X ticker and the on-chain token identity must match.
TARGET_TICKER=$ABC
REQUIRE_TICKER=true
TARGET_NAME=ABC
REQUIRE_NAME=true

# Trading
BUY_AMOUNT_ETH=0.001
# 4000 = 40% maximum slippage. Use carefully on live trading.
MAX_SLIPPAGE_BPS=4000
MAX_DAILY_SPEND_ETH=0.01
MAX_TRADES_PER_HOUR=5
MAX_RETRIES=1

# Low-latency polling. X API latency/rate limits still apply.
POLL_INTERVAL_MS=1000

# Safety: keep these settings for the trial.
DRY_RUN=true
AUTO_BUY=false
